# The job a cloud render runs. cloud/runpod/launch.sh --job <this file> puts it in the bundle as job.env, and
# cloud/runpod/job.sh reads it on the pod. Plain shell assignments.

PAGE=index.html              # the page, relative to the site folder (launch.sh --site)
SIZE=3840x2160               # the delivery size
SCALE=1                      # render at this multiple of SIZE and downsample with Lanczos (supersampling)
HDR=0                        # 1: HDR10 (P010 frames, HEVC Main 10, an MKV with the HDR10 metadata)
ENCODER=nvenc                # nvenc (x264, or x265 with HDR, on the CPU)
QUALITY=20                   # NVENC CQ, 0-51, lower is better (x264/x265: CRF)
PARAMS=""                    # parameters for the page, space-separated K=V
AUDIO=auto                   # auto (the page's own soundtrack, if it has one), none, or the file launch.sh --audio adds
NAME=film                    # the master's file name

JOB_FRAMES=500               # frames a job: one worker renders one job at a time (large jobs leave an idle tail)
HEAVY=""                     # frame ranges that render slowly, "A:B A:B": rendered first, in job-sized pieces
CUTS=""                      # the film's hard cuts, "120,840": the QA step expects them and flags any other
STARTS=""                    # other shot starts (shots that continue): the QA sheets show a still either side
STILLS_FULL=""               # frames to save at full size (PNG) for a 1:1 look, "600,1800"

MAX_WORKERS=16               # at most this many workers, whatever the pod allows
CORES_PER_WORKER=1.1         # CPU cores a worker needs (measured at 4K with the conversion on the GPU)
VRAM_PER_WORKER_GB=1.6       # video memory a worker needs (measured 1.45-1.6 GB at 4K: depends on your page)

YT_TITLE="My film"           # with launch.sh --upload: the title (it uploads as Private)
YT_PRIVACY=private
